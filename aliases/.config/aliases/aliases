# | ls |
# +----+

# -----------------------------
# Interactive aliases (colors, icons, Git info)
# -----------------------------
# Basic directory listing with colors, icons, and directories first
alias ls='eza --color=auto --icons --group-directories-first'  # list files interactively

# Long listing in bare format with Git info, colors, icons, directories first
alias l='eza -lbF --git --color=auto --icons --group-directories-first'  # quick interactive list

# Long listing with Git info, colors, icons, directories first, shows more details
alias ll='eza -lbGF --git --color=auto --icons --group-directories-first'  # detailed list

# Long listing sorted by modification time, Git info, colors, icons, directories first
alias llm='eza -lbG --git --sort=modified --color=auto --icons --group-directories-first'  # list by modification time

alias llt='eza --tree --level=2 --long --icons --git'

# Full long listing including hidden files, extended info, Git info, time in ISO format, color scale, icons
alias la='eza -lbhHigUmuSa --time-style=long-iso --git --color-scale --color=auto --icons --group-directories-first'  # all files, long info

# Full long listing with extended attributes (@), hidden files, Git info, color scale, icons
alias lx='eza -lbhHigUmuSa@ --time-style=long-iso --git --color-scale --color=auto --icons --group-directories-first'  # extended listing with attributes

# -----------------------------
# Specialty / script-friendly views
# -----------------------------
# One file per line (good for scripts or piping)
alias lS='eza -1'  # single column listing

# Tree view up to 2 levels deep
alias lt='eza --tree --level=2'  # tree view of directories

alias lta='lt -a'
alias lsa='ls -a'

# Show all hidden files safely using eza's pattern matching
alias l.='eza -a'  # show hidden files


