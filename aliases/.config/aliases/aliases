# +-----+
# | fzf |
# +-----+
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias eff='$EDITOR "$(ff)"'
sff() {
  if (( $# == 0 )); then
    echo "Usage: sff <destination> (e.g. sff host:/tmp/)"
    return 1
  fi

  local file
  file=$(find . -type f -printf '%T@\t%p\n' |
    sort -rn |
    cut -f2- |
    ff) &&
    [[ -n $file ]] &&
    scp "$file" "$1"
}


