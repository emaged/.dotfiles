#!/usr/bin/env python3
"""Toggle a persistent bottom shell in the invoking Herdr tab."""

import fcntl
import json
import os
import socket
import sys

TOKEN = "toggle_term_main"


def request(method, **params):
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(5)
        connection.connect(os.environ["HERDR_SOCKET_PATH"])
        payload = {"id": "toggle-term", "method": method, "params": params}
        connection.sendall((json.dumps(payload) + "\n").encode())
        with connection.makefile() as response:
            result = json.loads(response.readline())
    if "error" in result:
        raise RuntimeError(result["error"]["message"])
    return result["result"]


def toggle():
    # Custom bindings supply ACTIVE context; ordinary panes supply caller context.
    pane_id = os.environ.get("HERDR_ACTIVE_PANE_ID") or os.environ.get("HERDR_PANE_ID")
    if not pane_id:
        raise RuntimeError("Run from a Herdr pane or a Herdr command keybinding")
    current = request("pane.get", pane_id=pane_id)["pane"]
    panes = request("pane.list", workspace_id=current["workspace_id"])["panes"]
    panes = {p["pane_id"]: p for p in panes if p["tab_id"] == current["tab_id"]}
    terminal = next((p for p in panes.values() if TOKEN in p.get("tokens", {})), None)

    if terminal is None:
        # Ratio is the original (upper) pane's share of the split.
        request("pane.zoom", pane_id=pane_id, mode="off")
        terminal = request(
            "pane.split", target_pane_id=pane_id, direction="down", ratio=0.8,
            cwd=current.get("foreground_cwd") or current.get("cwd") or os.getcwd(),
            focus=True,
        )["pane"]
        request("pane.report_metadata", pane_id=terminal["pane_id"],
                source="dotfiles:toggle-term", tokens={TOKEN: pane_id})
        return

    terminal_id = terminal["pane_id"]
    main_id = terminal["tokens"][TOKEN]
    if main_id not in panes:
        # The original main pane may have been closed or moved to another tab.
        main_id = next((p for p in panes if p != terminal_id), None)
        if main_id is None:
            request("pane.focus", pane_id=terminal_id)
            return
        request("pane.report_metadata", pane_id=terminal_id,
                source="dotfiles:toggle-term", tokens={TOKEN: main_id})

    layout = request("pane.layout", pane_id=pane_id)["layout"]
    if layout["zoomed"]:
        request("pane.zoom", pane_id=pane_id, mode="off")
        request("pane.focus", pane_id=terminal_id)
    else:
        request("pane.focus", pane_id=main_id)
        request("pane.zoom", pane_id=main_id, mode="on")


if __name__ == "__main__":
    try:
        # Serialize rapid keypresses without creating a separate lock/state file.
        with open(__file__, "rb") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            toggle()
    except BlockingIOError:
        pass
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        print(f"herdr-toggle-term: {error}", file=sys.stderr)
        sys.exit(1)
