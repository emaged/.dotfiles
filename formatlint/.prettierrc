{
    "tabWidth": 2,
    "overrides": [
        {
            "files": [
                "*.js",
                "*.ts"
            ],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": [
                "*.md"
            ],
            "options": {
                "tabWidth": 4
            }
        },
        {
            "files": [
                "*.html",
                "*.jsx",
                "*.tsx"
            ],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
