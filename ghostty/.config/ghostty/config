theme = Catppuccin Mocha

# theme = GruvboxDark
font-family = JetBrainsMono Nerd Font Mono 
font-size = 12.5
gtk-titlebar = false

window-theme = ghostty
confirm-close-surface=false

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor, ssh-env

# keybinds
keybind = ctrl+backspace=text:\x17

# fix for tmux, maps to alt + enter
keybind = shift+enter=text:\x1b\r

keybind = performable:ctrl+shift+h=goto_split:left
keybind = performable:ctrl+shift+j=goto_split:bottom
keybind = performable:ctrl+shift+k=goto_split:top
keybind = performable:ctrl+shift+l=goto_split:right

keybind = ctrl+shift+f=toggle_split_zoom

# disable ligatures
# font-feature = -dlig
# font-feature = -liga
font-feature = -calt

