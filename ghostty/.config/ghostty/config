# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# theme = GruvboxDark
font-family = JetBrainsMono Nerd Font Mono
font-size = 12.5
gtk-titlebar = false

window-theme = ghostty
confirm-close-surface=false

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor, ssh-env

# keybinds
keybind = ctrl+backspace=text:\x17

keybind = performable:ctrl+shift+h=goto_split:left
keybind = performable:ctrl+shift+j=goto_split:bottom
keybind = performable:ctrl+shift+k=goto_split:top
keybind = performable:ctrl+shift+l=goto_split:right

keybind = ctrl+shift+f=toggle_split_zoom

# Scrollback / screen / selection -> paste path (Neovim-friendly)
keybind = ctrl+alt+j=write_scrollback_file:paste
keybind = ctrl+alt+k=write_screen_file:paste
keybind = ctrl+alt+l=write_selection_file:paste

# move tabs
keybind = ctrl+shift+alt+left=move_tab:-1
keybind = ctrl+shift+alt+right=move_tab:1

# disable ligatures
# font-feature = -dlig
# font-feature = -liga
font-feature = -calt


# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u

# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
