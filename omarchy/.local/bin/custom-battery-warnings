#!/bin/bash

WARN_THRESHOLD=20
CRITICAL_THRESHOLD=5

NOTIFICATION_DIR="/run/user/$UID"
WARN_FLAG="$NOTIFICATION_DIR/custom_battery_warned"
CRITICAL_FLAG="$NOTIFICATION_DIR/custom_battery_critical"

BATTERY_DEVICES=$(LC_ALL=C upower -e) || {
  echo "Error: could not list UPower devices." >&2
  exit 1
}
BATTERY_DEVICE=$(awk '/BAT/ { print; exit }' <<< "$BATTERY_DEVICES")
[[ -n "$BATTERY_DEVICE" ]] || exit 0

BATTERY_INFO=$(LC_ALL=C upower -i "$BATTERY_DEVICE") || {
  echo "Error: could not read UPower battery information." >&2
  exit 1
}
BATTERY_LEVEL=$(awk '$1 == "percentage:" && $2 ~ /^[0-9]+([.][0-9]+)?%$/ && $2 + 0 <= 100 {
  print int($2); found = 1; exit
} END { if (!found) exit 1 }' <<< "$BATTERY_INFO") || {
  echo "Error: invalid or missing battery percentage." >&2
  exit 1
}
BATTERY_STATE=$(awk '$1 == "state:" { print $2; exit }' <<< "$BATTERY_INFO")
case "$BATTERY_STATE" in
  charging|discharging|empty|fully-charged|pending-charge|pending-discharge) ;;
  *)
    echo "Error: invalid or missing battery state." >&2
    exit 1
    ;;
esac

send_warn() {
  notify-send -u normal "󰂃 Battery getting low" "Battery is at ${1}%" -i battery-low -t 15000
}

send_critical() {
  notify-send -u critical "󰂎 Plug in NOW!" "Battery is at ${1}% — system may power off" -i battery-empty -t 0
}

if [[ -n "$BATTERY_LEVEL" && "$BATTERY_LEVEL" =~ ^[0-9]+$ ]]; then
  if [[ $BATTERY_STATE == "discharging" ]]; then

    if [[ $BATTERY_LEVEL -le $CRITICAL_THRESHOLD ]]; then
      if [[ ! -f $CRITICAL_FLAG ]]; then
        send_critical "$BATTERY_LEVEL"
        touch "$CRITICAL_FLAG"
      fi

    elif [[ $BATTERY_LEVEL -le $WARN_THRESHOLD ]]; then
      if [[ ! -f $WARN_FLAG ]]; then
        send_warn "$BATTERY_LEVEL"
        touch "$WARN_FLAG"
      fi
    fi

  else
    rm -f "$WARN_FLAG" "$CRITICAL_FLAG"
  fi
fi
