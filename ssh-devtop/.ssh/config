Include ~/.ssh/config.d/1password.conf

# Preserve the desktop's existing disk-key selection only for local use.
# A forwarded session must not silently fall back to this private key.
Match exec "test \"${DOTFILES_AGENT_CHOICE:-}\" = local || { test -z \"${DOTFILES_AGENT_CHOICE:-}\" && test -z \"${SSH_CONNECTION:-}\"; }"
    IdentityFile ~/.ssh/id_ed25519

Host *
    AddKeysToAgent yes
