# OpenSSH runs this hook; Tailscale SSH uses the matching .zshenv hook.
# No stdout: Herdr's SSH transport carries a protocol, not an interactive shell.
if [ -n "${SSH_CONNECTION:-}" ] && [ -n "${SSH_AUTH_SOCK:-}" ]; then
    /usr/bin/python3 "$HOME/.ssh/agent-routing.py" register >/dev/null 2>&1
fi

if [ "${1:-}" = "--agent-only" ]; then
    exit 0
fi

# Preserve the system hook and sshd's usual X11-cookie handling.
if [ -r /etc/ssh/sshrc ]; then
    exec /bin/sh /etc/ssh/sshrc
elif [ -n "${DISPLAY:-}" ] && read -r proto cookie; then
    case "$DISPLAY" in
        localhost:*) forwarded_x11_display="unix:${DISPLAY#localhost:}" ;;
        *) forwarded_x11_display="$DISPLAY" ;;
    esac
    printf 'add %s %s %s\n' "$forwarded_x11_display" "$proto" "$cookie" | xauth -q -
fi
